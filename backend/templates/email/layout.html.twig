<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ email.subject }}</title>
</head>
<body style="margin:0;padding:0;background:#EEE9DF;color:#16191C;font-family:'Hanken Grotesk',Arial,Helvetica,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#EEE9DF;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#F7F4EE;border:1px solid #CFCABF;">
<tr><td style="padding:28px 32px 0 32px;">
<span style="font-family:Georgia,'Times New Roman',serif;font-size:34px;line-height:1;color:#16191C;">SBC<span style="color:#B4502E;">.</span></span>
</td></tr>
<tr><td style="padding:16px 32px 0 32px;"><div style="height:1px;background:#CFCABF;line-height:1px;font-size:1px;">&nbsp;</div></td></tr>
<tr><td style="padding:12px 32px 0 32px;font-family:'DM Mono','Courier New',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:#9A4023;">
{% block caption %}Demande de devis{% endblock %}
</td></tr>
<tr><td style="padding:20px 32px 8px 32px;font-size:15px;line-height:1.65;color:#16191C;">
{% block content %}{% endblock %}
</td></tr>
<tr><td style="padding:24px 32px 28px 32px;">
<div style="height:1px;background:#CFCABF;line-height:1px;font-size:1px;">&nbsp;</div>
<p style="margin:12px 0 0 0;font-family:'DM Mono','Courier New',monospace;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#6b665c;">SBC, entrepreneur général en rénovation, région parisienne</p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
