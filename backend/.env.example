# Symfony backend example variables
APP_ENV=dev
APP_SECRET=change-this-secret
DEFAULT_URI=http://localhost:8080

# MySQL 8 connection
DATABASE_URL="mysql://sbc:sbc@mysql:3306/sbc?serverVersion=8.0&charset=utf8mb4"

# Mailer and async queue
# En production: MAILER_DSN=resend+api://${RESEND_API_KEY}@default (dans .env.local)
MAILER_DSN=null://null
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
MESSENGER_TRANSPORT_DSN=doctrine://default

# Notifications and security
NOTIFICATION_EMAIL=sbc.nefzi@gmail.com
TURNSTILE_SECRET_KEY=
REVALIDATE_WEBHOOK_URL=http://node:3000/internal/revalidate
REVALIDATE_SECRET=changeme

# Secret admin path duplicated on frontend
ADMIN_PATH=/atelier-admin
